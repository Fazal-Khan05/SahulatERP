# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and keys (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: sb_publishable_…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: sb_secret_… Server-only; used by migrations and the worker, never by request handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app; links in auth emails point here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database connections hold the database password: local and CI only, never on Vercel.
# Transaction pooler (port 6543).
DATABASE_URL=
# Session connection (port 5432), used by drizzle-kit.
MIGRATION_DATABASE_URL=
