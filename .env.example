# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and keys (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: sb_publishable_…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: sb_secret_… Used by `npm run owner:create`, `npm run invites:send` and the end-to-end
# tests. Local only, never on Vercel; request handlers never use it.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app; links in auth emails point here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The web app's database connection: the app_runtime role through the transaction pooler
# (port 6543). app_runtime cannot bypass row-level security. `npm run db:runtime-password` writes
# this line; the same value goes on Vercel.
DATABASE_URL=
# What the web app signs "who is signed in" with, for the database to check
# (drizzle/0031_identity_proof.sql and the security clean-up after Step 47). One of the two; a
# database believes nobody without it, so with both empty every page comes back with nothing.
#
# The private key (the way to be on): `npm run db:identity -- generate-key` writes this line; the
# same value goes on Vercel, and `npm run db:identity -- install` puts its public half in the
# database, where it is no secret.
IDENTITY_SIGNING_KEY=
# The shared secret (how it began; 64 hexadecimal characters, `npm run db:identity -- generate`):
# the database holds the same secret, readable by whoever can read every table. Used only when
# there is no key above. `npm run db:identity -- retire-secret --yes` takes it out of the database
# once the deployed app signs with the key; then leave this empty.
IDENTITY_SIGNING_SECRET=
# Two-step sign-in is required of owners and accountants unless this says `off` (src/lib/auth/rules.ts).
# `off` is for a site that only shows a demo: every member may then say "Not now". Leave it empty,
# or take it away, before a real company's books go in.
TWO_STEP_REQUIRED=
# The postgres role through the session pooler (port 5432), used by drizzle-kit, the scripts in
# scripts/ (including the background worker, `npm run worker`) and the tests. It bypasses
# row-level security: local only, never on Vercel.
MIGRATION_DATABASE_URL=
