# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and keys (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: sb_publishable_…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: sb_secret_… Used by `npm run owner:create`, `npm run invites:send` and the end-to-end
# tests. Local only, never on Vercel; request handlers never use it.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app; links in auth emails point here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The web app's database connection: the app_runtime role through the transaction pooler
# (port 6543). app_runtime cannot bypass row-level security. `npm run db:runtime-password` writes
# this line; the same value goes on Vercel.
DATABASE_URL=
# The postgres role through the session pooler (port 5432), used by drizzle-kit, the scripts in
# scripts/ (including the background worker, `npm run worker`) and the tests. It bypasses
# row-level security: local only, never on Vercel.
MIGRATION_DATABASE_URL=
