{
  "name": "sahulaterp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local": "sh scripts/local-db.sh",
    "db:set-aside": "node scripts/migration-aside.mjs set-aside",
    "db:undo-aside": "node --env-file-if-exists=.env.local scripts/migration-aside.mjs undo-aside",
    "db:put-back": "node scripts/migration-aside.mjs put-back",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:runtime-password": "node --env-file-if-exists=.env.local scripts/db-runtime-password.mjs",
    "owner:create": "node --env-file-if-exists=.env.local scripts/owner-create.mjs",
    "invites:send": "node --env-file-if-exists=.env.local scripts/invites-send.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "check": "npm run check:migrations && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
